<!-- Hộp thoại nhỏ hỏi một dòng chữ (lý do hủy lịch, lý do trả đơn...). -->
<Window x:Class="ClinicManagementSystem.Desktop.Services.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FocusManager.FocusedElement="{Binding ElementName=AnswerBox}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AnswerBox" MaxLength="500" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" />
        <TextBlock Text="Bắt buộc nhập, tối đa 500 ký tự." Style="{StaticResource Hint}" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Xác nhận" IsDefault="True" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
