<!-- Tiêu đề trang: lấy Title/Subtitle từ PageViewModel. Các nút thao tác đặt trong vùng Actions. -->
<UserControl x:Class="ClinicManagementSystem.Desktop.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}"
                       Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{Binding Actions, ElementName=Root}" />
    </Grid>
</UserControl>
