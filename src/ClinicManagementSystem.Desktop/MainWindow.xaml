<!--
  Cửa sổ chính (khung ứng dụng - phần việc của A). DataContext = ShellViewModel.
  Trái: menu theo vai trò. Phải: ContentControl hiển thị Navigator.CurrentPage.
  WPF tự chọn View cho từng ViewModel nhờ các DataTemplate trong Themes/ViewMappings.xaml
  ("thấy BookingViewModel thì vẽ BookingView").
-->
<Window x:Class="ClinicManagementSystem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phòng khám Nhi Đồng" Width="1320" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu trái: chỉ hiện khi đã đăng nhập -->
        <Border Width="240" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,18">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="✚" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nhi Đồng" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="CLINIC MANAGEMENT" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Đăng xuất" Style="{StaticResource SmallButton}"
                                Command="{Binding SignOutCommand}" />
                        <StackPanel>
                            <TextBlock Text="{Binding UserDisplayName}" Style="{StaticResource Strong}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource CellSub}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}" Margin="10,0"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="8" Padding="12,10" Margin="0,2" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="24" FontSize="14" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Vùng nội dung: đổi theo trang đang mở -->
        <ContentControl Grid.Column="1" Margin="28,22" Content="{Binding Navigator.CurrentPage}" Focusable="False" />
    </Grid>
</Window>
