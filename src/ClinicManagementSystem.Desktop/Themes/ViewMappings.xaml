<!--
  "Bản đồ" ViewModel -> View. Khi ContentControl nhận một BookingViewModel, WPF tìm DataTemplate có
  DataType = BookingViewModel và vẽ BookingView, đồng thời gán DataContext của view = chính ViewModel đó.
  Nhờ vậy ViewModel KHÔNG cần biết View nào hiển thị nó (ViewModel-first navigation).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Shell;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:rec="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Reception;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:doc="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Doctor;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:bill="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Billing;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:pharm="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Pharmacy;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:admin="clr-namespace:ClinicManagementSystem.Desktop.ViewModels.Admin;assembly=ClinicManagementSystem.Desktop.ViewModels"
                    xmlns:vshell="clr-namespace:ClinicManagementSystem.Desktop.Views.Shell"
                    xmlns:vrec="clr-namespace:ClinicManagementSystem.Desktop.Views.Reception"
                    xmlns:vdoc="clr-namespace:ClinicManagementSystem.Desktop.Views.Doctor"
                    xmlns:vbill="clr-namespace:ClinicManagementSystem.Desktop.Views.Billing"
                    xmlns:vpharm="clr-namespace:ClinicManagementSystem.Desktop.Views.Pharmacy"
                    xmlns:vadmin="clr-namespace:ClinicManagementSystem.Desktop.Views.Admin">

    <DataTemplate DataType="{x:Type shell:LoginViewModel}"><vshell:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type shell:DashboardViewModel}"><vshell:DashboardView /></DataTemplate>

    <!-- Phần C: tiếp tân -->
    <DataTemplate DataType="{x:Type rec:AppointmentListViewModel}"><vrec:AppointmentListView /></DataTemplate>
    <DataTemplate DataType="{x:Type rec:BookingViewModel}"><vrec:BookingView /></DataTemplate>
    <DataTemplate DataType="{x:Type rec:CheckInQueueViewModel}"><vrec:CheckInQueueView /></DataTemplate>
    <DataTemplate DataType="{x:Type rec:CheckInViewModel}"><vrec:CheckInView /></DataTemplate>
    <DataTemplate DataType="{x:Type rec:PatientListViewModel}"><vrec:PatientListView /></DataTemplate>
    <DataTemplate DataType="{x:Type rec:CreatePatientViewModel}"><vrec:CreatePatientView /></DataTemplate>

    <DataTemplate DataType="{x:Type doc:DoctorQueueViewModel}"><vdoc:DoctorQueueView /></DataTemplate>
    <DataTemplate DataType="{x:Type doc:ConsultationViewModel}"><vdoc:ConsultationView /></DataTemplate>
    <DataTemplate DataType="{x:Type bill:InvoiceListViewModel}"><vbill:InvoiceListView /></DataTemplate>
    <DataTemplate DataType="{x:Type pharm:PharmacyQueueViewModel}"><vpharm:PharmacyQueueView /></DataTemplate>
    <DataTemplate DataType="{x:Type admin:UserListViewModel}"><vadmin:UserListView /></DataTemplate>
</ResourceDictionary>
