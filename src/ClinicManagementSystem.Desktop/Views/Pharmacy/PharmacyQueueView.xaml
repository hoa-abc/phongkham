<!-- Dược sĩ: trái là danh sách đơn, phải là chi tiết đơn + Cấp phát / Trả về. DataContext = PharmacyQueueViewModel. -->
<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Pharmacy.PharmacyQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <DockPanel>
        <c:PageHeader DockPanel.Dock="Top">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Xem lịch sử đã xử lý" IsChecked="{Binding ShowHistory}" Margin="0,0,12,0" />
                    <Button Content="⟳ Làm mới" Command="{Binding LoadCommand}" />
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>
        <c:MessageBar DockPanel.Dock="Top" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,16,0"
                     Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource CardListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PatientLine}" Style="{StaticResource Strong}" />
                            <TextBlock Style="{StaticResource CellSub}">
                                BS <Run Text="{Binding DoctorName, Mode=OneWay}" /> · <Run Text="{Binding ItemCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource CellSub}">
                                <Run Text="{Binding StatusLabel, Mode=OneWay}" /> · <Run Text="{Binding IssuedAt, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="⚠ Thiếu tồn kho" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                                       Visibility="{Binding HasStockIssue, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chọn một đơn ở danh sách bên trái." Style="{StaticResource Hint}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisInverse}}" />
                    <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <ContentControl Content="{Binding Patient}" Focusable="False" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                <DataGrid ItemsSource="{Binding DetailItems}" RowHeight="40" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thuốc" Binding="{Binding Medicine}" Width="2*" />
                                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*" />
                                        <DataGridTemplateColumn Header="Tồn kho" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Stock}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnough}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Cách dùng" Binding="{Binding Dosage}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Style="{StaticResource WarnBox}" Margin="0,0,0,12"
                                        Visibility="{Binding BlockReason, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding BlockReason}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Trả về bác sĩ" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                            Command="{Binding ReturnToDoctorCommand}" IsEnabled="{Binding CanReturn}" />
                                    <Button Content="Xác nhận cấp phát" Style="{StaticResource PrimaryButton}" Padding="20,9"
                                            Command="{Binding DispenseCommand}" IsEnabled="{Binding CanDispense}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Lịch sử trạng thái đơn" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
