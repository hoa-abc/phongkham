<!-- Thu ngân: trái là danh sách hóa đơn, phải là chi tiết hóa đơn đang chọn. DataContext = InvoiceListViewModel. -->
<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Billing.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <DockPanel>
        <c:PageHeader DockPanel.Dock="Top" />
        <c:MessageBar DockPanel.Dock="Top" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Lọc theo trạng thái" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedInvoice}"
                         Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource CardListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource Strong}" />
                                    <TextBlock Text="{Binding InvoiceNumber}" Style="{StaticResource Strong}" />
                                </DockPanel>
                                <TextBlock Text="{Binding PatientLine}" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Style="{StaticResource CellSub}">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" /> · <Run Text="{Binding CreatedAt, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chọn một hóa đơn ở danh sách bên trái." Style="{StaticResource Hint}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisInverse}}" />
                    <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <ContentControl Content="{Binding Patient}" Focusable="False" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding Lines}" RowHeight="38" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nội dung" Binding="{Binding Description}" Width="3*" />
                                        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="*" />
                                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice}" Width="*" />
                                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" />
                                    <TextBlock Text="Tổng cộng" Style="{StaticResource Strong}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border Style="{StaticResource WarnBox}" Margin="0,0,0,12"
                                        Visibility="{Binding CannotPayReason, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding CannotPayReason}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
                                </Border>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Thu tiền" Style="{StaticResource PrimaryButton}" Padding="22,9"
                                            Command="{Binding PayCommand}" IsEnabled="{Binding CanPay}" />
                                    <ComboBox DockPanel.Dock="Right" Width="180" Margin="0,0,10,0" ItemsSource="{Binding PaymentMethods}"
                                              SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label" IsEnabled="{Binding CanPay}" />
                                    <Button Content="Hủy / hoàn hóa đơn" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                            Command="{Binding VoidCommand}" Visibility="{Binding CanVoid, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
