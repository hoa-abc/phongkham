<!--
  PHẦN C · Ghi sinh hiệu và check-in. DataContext = CheckInViewModel.
  Ô nhập sai -> viền đỏ + chữ lỗi bên dưới, NGAY khi rời ô (ObservableValidator + INotifyDataErrorInfo).
  TargetNullValue='' : ô trống tương ứng giá trị null trong ViewModel (để [Required] bắt được "chưa nhập").
-->
<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Reception.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <c:PageHeader>
                <c:PageHeader.Actions>
                    <Button Content="← Hàng chờ" Command="{Binding BackCommand}" />
                </c:PageHeader.Actions>
            </c:PageHeader>
            <c:MessageBar />
            <ContentControl Content="{Binding Patient}" Focusable="False" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Chỉ số sinh hiệu (bắt buộc)" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,22">
                                <TextBlock Text="Cân nặng (kg)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WeightKg, TargetNullValue=''}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,22">
                                <TextBlock Text="Chiều cao (cm)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding HeightCm, TargetNullValue=''}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,22">
                                <TextBlock Text="Nhịp tim (lần/phút)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding HeartRate, TargetNullValue=''}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="Nhiệt độ (°C)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TemperatureC, TargetNullValue=''}" />
                            </StackPanel>
                        </UniformGrid>
                        <Border Style="{StaticResource WarnBox}" Margin="0,0,0,12" Visibility="{Binding IsFever, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="⚠ Nhiệt độ từ 38 °C trở lên. Hãy báo điều dưỡng/bác sĩ theo quy trình của phòng khám." />
                        </Border>
                        <TextBlock Text="Triệu chứng ban đầu" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Symptoms}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="1000" />
                        <Button Content="Xác nhận Check-in" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                Margin="0,14,0,0" Padding="22,9" Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Lịch hẹn đang tiếp nhận" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Giờ hẹn" Style="{StaticResource CellSub}" />
                        <TextBlock Foreground="{StaticResource TextBrush}" Margin="0,0,0,8">
                            <Run Text="{Binding Appointment.Time, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding Appointment.Date, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="Bác sĩ" Style="{StaticResource CellSub}" />
                        <TextBlock Text="{Binding Appointment.DoctorName}" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding Appointment.DoctorSpecialty}" Style="{StaticResource CellSub}" Margin="0,0,0,8" />
                        <TextBlock Text="Trạng thái" Style="{StaticResource CellSub}" />
                        <TextBlock Text="{Binding Appointment.StatusLabel}" Style="{StaticResource Strong}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Sau khi check-in, hệ thống tạo lượt khám và đưa bé vào hàng đợi của bác sĩ này." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
