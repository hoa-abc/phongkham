<!--
  PHẦN C · Đặt lịch khám. DataContext = BookingViewModel.
  Bố cục 3 bước theo luồng tiếp tân: (1) bệnh nhi  (2) bác sĩ, ngày, khung giờ  (3) xác nhận.
  Toàn bộ là BINDING: XAML không có một dòng logic nào; chọn bác sĩ/ngày -> ViewModel tự tải lưới giờ.
-->
<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Reception.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <DockPanel>
        <c:PageHeader DockPanel.Dock="Top">
            <c:PageHeader.Actions>
                <Button Content="Xem danh sách lịch hẹn" Command="{Binding OpenAppointmentListCommand}" />
            </c:PageHeader.Actions>
        </c:PageHeader>
        <c:MessageBar DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- ===== Bước 1: bệnh nhi ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tìm và chọn bệnh nhi" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="⌕ Tìm" Margin="8,0,0,0" Command="{Binding SearchPatientsCommand}" />
                                <TextBox Text="{Binding PatientKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Gõ mã BN, tên bé, tên hoặc SĐT phụ huynh rồi nhấn Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchPatientsCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" MaxHeight="230"
                                     Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource CardListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Strong}">
                                                    <Run Text="{Binding MedicalRecordNumber, Mode=OneWay}" /> · <Run Text="{Binding FullName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource CellSub}">
                                                    <Run Text="{Binding Age, Mode=OneWay}" /> · PH: <Run Text="{Binding GuardianLine, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="⚠ Dị ứng" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="＋ Chưa có hồ sơ? Tạo hồ sơ mới" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Style="{StaticResource SmallButton}" Command="{Binding CreatePatientCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Bước 2: bác sĩ, ngày, khung giờ ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Chọn bác sĩ, ngày và khung giờ trống" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Bác sĩ phụ trách" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding Specialty, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ngày khám" Style="{StaticResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding SelectedDate}" DisplayDateStart="{Binding MinDate, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Lưới khung giờ: ListBox 5 cột. Khung không còn trống bị KHÓA (IsEnabled=false) và ghi rõ lý do. -->
                            <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                     Style="{StaticResource CardList}" AutomationProperties.Name="Khung giờ khám">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource CellSub}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- ===== Bước 3: xác nhận ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Lý do khám và xác nhận" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="64" TextWrapping="Wrap"
                                     AcceptsReturn="True" MaxLength="1000" ToolTip="Ví dụ: sốt, ho 2 ngày" />
                            <!-- Nút tự mờ đi khi chưa đủ điều kiện: nhờ CanExecute của ConfirmCommand -->
                            <Button Content="Xác nhận lịch" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                    Margin="0,12,0,0" Padding="22,9" Command="{Binding ConfirmCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Tóm tắt bên phải ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Tóm tắt lịch hẹn" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Chưa chọn bệnh nhi." Style="{StaticResource Hint}"
                               Visibility="{Binding HasPatient, Converter={StaticResource BoolToVisInverse}}" />
                    <StackPanel Visibility="{Binding HasPatient, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Bệnh nhi" Style="{StaticResource CellSub}" />
                        <TextBlock Text="{Binding SelectedPatient.FullName}" Style="{StaticResource Strong}" FontSize="15" />
                        <TextBlock Text="{Binding SelectedPatient.MedicalRecordNumber}" Style="{StaticResource CellSub}" Margin="0,0,0,8" />
                        <TextBlock Text="Tuổi" Style="{StaticResource CellSub}" />
                        <TextBlock Text="{Binding SelectedPatient.Age}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Phụ huynh" Style="{StaticResource CellSub}" />
                        <TextBlock Text="{Binding SelectedPatient.GuardianLine}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,8"
                                Visibility="{Binding SelectedPatient.HasAllergies, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedPatient.AllergyText}" Foreground="{StaticResource DangerBrush}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Bác sĩ" Style="{StaticResource CellSub}" />
                    <TextBlock Text="{Binding SelectedDoctor.DisplayName}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding SelectedDoctor.Specialty}" Style="{StaticResource CellSub}" Margin="0,0,0,8" />
                    <TextBlock Text="Giờ khám" Style="{StaticResource CellSub}" />
                    <TextBlock Text="{Binding SummaryTime}" Style="{StaticResource Strong}" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Mỗi khung dài 30 phút. Hệ thống kiểm tra lại khi lưu: nếu quầy khác vừa đặt khung này, bạn sẽ được báo để chọn giờ khác." />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
