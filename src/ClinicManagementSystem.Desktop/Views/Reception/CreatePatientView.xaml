<!-- PHẦN C · Tạo hồ sơ bệnh nhi. DataContext = CreatePatientViewModel. Lưu xong tự sang Đặt lịch. -->
<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Reception.CreatePatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <c:PageHeader />
            <c:MessageBar />
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Thông tin bé" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,22">
                            <TextBlock Text="Họ tên bé (*)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,22">
                            <TextBlock Text="Ngày sinh (*)" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding DateOfBirth}" DisplayDateEnd="{Binding MaxBirthDate, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,22">
                            <TextBlock Text="Giới tính" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding SelectedGender}" DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Người giám hộ" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,22">
                            <TextBlock Text="Số điện thoại (*)" Style="{StaticResource FieldLabel}" />
                            <!-- Delay=400: đợi người dùng ngừng gõ 0,4 giây rồi mới tra cứu SĐT -->
                            <TextBox Text="{Binding GuardianPhone, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,22">
                            <TextBlock Text="Họ tên người giám hộ (*)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GuardianName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,22">
                            <TextBlock Text="Quan hệ với bé" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding RelationshipOptions}" SelectedItem="{Binding SelectedRelationship}" DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding GuardianNote}" Style="{StaticResource Hint}" Foreground="{StaticResource PrimaryDarkBrush}"
                               Margin="0,0,0,10" Visibility="{Binding GuardianNote, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="Địa chỉ" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding GuardianAddress}" MaxLength="300" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Dị ứng đã biết (nếu có)" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Tên dị nguyên (ví dụ: Amoxicillin)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AllergyName}" MaxLength="160" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Mức độ" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phản ứng" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AllergyReaction}" MaxLength="500" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                <Button Content="Lưu hồ sơ và đặt lịch →" Style="{StaticResource PrimaryButton}" Padding="20,9" Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
