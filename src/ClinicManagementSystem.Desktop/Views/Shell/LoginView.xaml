<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Shell.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <Border Style="{StaticResource Card}" Width="400" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="✚" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Phòng khám Nhi Đồng" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,2" />
            <TextBlock Text="Đăng nhập để bắt đầu ca làm việc" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,0,0,22" />

            <c:MessageBar />

            <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabel}" />
            <!-- PasswordBox không bind được: code-behind chép mật khẩu sang ViewModel khi gõ. -->
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" Margin="0,0,0,20" />

            <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="0,10"
                    Command="{Binding SignInCommand}" />
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Tài khoản demo: letan · bacsi · duocsi · admin&#x0a;(mật khẩu trong appsettings.Local.json)" />
        </StackPanel>
    </Border>
</UserControl>
