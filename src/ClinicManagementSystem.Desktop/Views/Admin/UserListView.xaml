<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Admin.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <DockPanel>
        <c:PageHeader DockPanel.Dock="Top" />
        <c:MessageBar DockPanel.Dock="Top" />
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" BorderThickness="0" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding UserName}" Width="*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Họ tên hiển thị" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleLabel}" Width="*" />
                    <DataGridTextColumn Header="Chuyên khoa / phòng" Binding="{Binding Specialty}" Width="2*" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="*" />
                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
