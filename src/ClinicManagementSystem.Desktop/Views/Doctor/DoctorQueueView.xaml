<UserControl x:Class="ClinicManagementSystem.Desktop.Views.Doctor.DoctorQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ClinicManagementSystem.Desktop.Controls">
    <DockPanel>
        <c:PageHeader DockPanel.Dock="Top">
            <c:PageHeader.Actions>
                <Button Content="⟳ Làm mới" Command="{Binding LoadCommand}" />
            </c:PageHeader.Actions>
        </c:PageHeader>
        <c:MessageBar DockPanel.Dock="Top" />
        <TextBlock DockPanel.Dock="Top" Text="Chưa có bé nào trong hàng đợi." Style="{StaticResource Strong}" Margin="0,0,0,10"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Giờ" Binding="{Binding Time}" Width="64" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="Bệnh nhi" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PatientName}" Style="{StaticResource Strong}" />
                                        <TextBlock Text="  ⚠ dị ứng" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding HasAllergies, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CellSub}">
                                        <Run Text="{Binding MedicalRecordNumber, Mode=OneWay}" /> · <Run Text="{Binding Age, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Lượt khám" Binding="{Binding StatusLabel}" Width="*" />
                    <DataGridTemplateColumn Header="Đơn thuốc" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding PrescriptionLabel}" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding ReturnReason}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap"
                                               Visibility="{Binding HasReturnReason, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Mở hồ sơ khám" Style="{StaticResource SmallPrimaryButton}" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
